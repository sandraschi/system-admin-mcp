        {"label": "Processes", "path": "/processes"},
        {"label": "Services", "path": "/services"},
        {"label": "Volumes", "path": "/volumes"},
        {"label": "Logs", "path": "/logs"},
        {"label": "Settings", "path": "/settings"}
