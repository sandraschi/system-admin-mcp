{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": ["sandraschi"],
  "name": "system-admin-mcp",
  "version": "0.4.0",
  "description": "FastMCP 3.4 server for elevated Windows system administration: NTFS file recovery, security/ACL management, disk maintenance, service/process orchestration, system diagnostics, startup and taskbar management.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 3.4.4",
  "tools": 44,
  "transport": ["stdio", "streamable-http"],
  "keywords": [
    "windows",
    "system-admin",
    "file-recovery",
    "security",
    "disk-maintenance",
    "diagnostics",
    "mcp-server",
    "fastmcp"
  ],
  "features": {
    "file_recovery": {
      "enabled": true,
      "filesystem": "NTFS"
    },
    "security_management": {
      "enabled": true,
      "operations": ["permissions", "access_control"]
    },
    "volume_maintenance": {
      "enabled": true
    },
    "system_diagnostics": {
      "enabled": true
    },
    "service_management": {
      "enabled": true
    },
    "process_management": {
      "enabled": true
    },
    "requires_admin": {
      "enabled": true,
      "note": "Administrator privileges required for recovery, defrag, and ownership operations"
    }
  }
}
